# =============================================================
# Áncora ⚓ — Plantilla de configuración
# Copia este fichero a .env.local y rellena los valores reales.
# .env.local está en .gitignore: NUNCA subas claves al repositorio.
# =============================================================

# --- Firebase (la apiKey de Firebase es pública por diseño) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=ayuda-emilio-83261.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=ayuda-emilio-83261
VITE_FIREBASE_STORAGE_BUCKET=ayuda-emilio-83261.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=375420549895
VITE_FIREBASE_APP_ID=

# --- Motor de IA clínica: router OmniRoute ---
# Endpoint OpenAI-compatible. En producción debe ser la URL pública.
VITE_OMNIROUTE_URL=https://143-47-35-167.sslip.io/pro/omniroute/v1
# ATENCIÓN: en una SPA esta clave viaja al bundle del navegador y es legible
# por cualquiera que abra la web. Es una medida de contención, no un secreto.
# El aislamiento real exige un proxy en servidor (Cloud Function).
VITE_OMNIROUTE_API_KEY=

# --- Modelos por tarea clínica (resueltos en OmniRoute) ---
# Extracción estructurada de documentos, audios y conversaciones
VITE_AI_MODEL_DEEP=claude/claude-opus-5
# Informes periódicos para el psicólogo y notas SOAP
VITE_AI_MODEL_REPORT=claude/claude-sonnet-5
# Acompañamiento conversacional con el paciente (baja latencia)
VITE_AI_MODEL_CHAT=claude/claude-haiku-4-5-20251001
# Transcripción de voz a texto
VITE_AI_MODEL_STT=groq/whisper-large-v3

# --- Gateway anterior (aiService.js, en migración a claudeService.js) ---
VITE_AI_PROXY_URL=https://143-47-35-167.sslip.io/pro/freellmapi/v1
VITE_AI_API_KEY=
